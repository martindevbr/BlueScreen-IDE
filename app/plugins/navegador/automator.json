      "inputs": ["in"], "outputs": ["out"],
      "params": { "url": "", "steps": [], "show": "yes", "after": "close", "wait_s": 15 },
      "fields": [
        { "name": "url", "label": "Endereço", "kind": "text", "placeholder": "https://…" },
        { "name": "steps", "label": "Passos", "kind": "rows", "add": "Passo", "recorder": true,
          "help": "Gravar abre o site: use ele normalmente e cada ação vira um passo. Onde: um seletor CSS (#senha, .botao) ou texto=Entrar para achar pelo texto. Em Ler campo, o valor é o nome do campo na saída. Senhas: {{vault:site}}.",
          "columns": [
            { "name": "do", "kind": "select", "options": [
              { "value": "click", "label": "Clicar", "tone": "act" }, { "value": "type", "label": "Digitar", "tone": "act" }, { "value": "select", "label": "Escolher opção", "tone": "act" },
              { "value": "key", "label": "Apertar tecla", "tone": "act" }, { "value": "hover", "label": "Passar o mouse", "tone": "act" }, { "value": "goto", "label": "Ir para endereço", "tone": "act" },
              { "value": "read", "label": "Ler campo (devolver)", "tone": "read" }, { "value": "shot", "label": "Capturar tela", "tone": "read" },
              { "value": "wait", "label": "Esperar aparecer", "tone": "wait" }, { "value": "sleep", "label": "Esperar (segundos)", "tone": "wait" },
              { "value": "text", "label": "Conferir texto", "tone": "check" }, { "value": "see", "label": "Conferir que aparece", "tone": "check" } ] },
            { "name": "on", "placeholder": "Onde: #id ou texto=Entrar", "hide": { "do": ["key", "goto", "sleep", "shot"] } },
            { "name": "value", "placeholder": "Valor", "hide": { "do": ["click", "wait", "see", "hover"] } }
          ] },
        { "name": "show", "label": "Janela do navegador", "kind": "select", "options": [{ "value": "yes", "label": "Mostrar" }, { "value": "no", "label": "Não mostrar" }] },
        { "name": "after", "label": "No fim", "kind": "select", "show": { "show": ["yes"] }, "options": [{ "value": "close", "label": "Fechar o navegador" }, { "value": "keep", "label": "Deixar aberto" }] },
        { "name": "wait_s", "label": "Esperar cada elemento por até (segundos)", "kind": "number", "min": 1, "max": 300 }
      ],
      "record": { "args": ["site.js", "--record"] },
      "run": { "program": "node", "args": ["site.js"], "timeout": 600000 }
    }
  ]
