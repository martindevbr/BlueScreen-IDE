{
  "nodes": [
    {
      "type": "test", "name": "Testar site", "category": "QA",
      "desc": "Roda um roteiro no site e confere o resultado: passou ou falhou, com evidência e relatório.",
      "takes": "any", "gives": "object",
      "expects": "Qualquer dado, para usar no endereço e nos passos com {{input}}.",
      "returns": "O resultado do teste, pela saída sim (passou) ou não (falhou): cada passo, os campos lidos da tela, a evidência da falha e o caminho do relatório.",
      "sample": { "ok": false, "name": "Login", "passed": 4, "failed": 1, "skipped": 0, "total": 5, "ms": 6200, "url": "https://exemplo.com/conta", "title": "Minha conta", "values": { "saldo": "R$ 120,00" },
        "steps": [{ "n": 1, "do": "click", "name": "Clicar", "on": "texto=Entrar", "ok": true, "ms": 410 }, { "n": 2, "do": "text", "name": "Conferir texto", "on": "h1", "value": "Olá", "ok": false, "ms": 15000, "error": "esperava \"Olá\", mas está \"Erro\"", "shot": "C:\\…\\passo-2.png" }],
        "js_errors": [], "bad_requests": [{ "status": 500, "url": "https://exemplo.com/api/conta" }], "report": "C:\\…\\relatorios\\teste-20261112.html" },
      "inputs": ["in"], "outputs": ["true", "false"],
      "params": { "name": "", "url": "", "steps": [], "device": "desktop", "on_fail": "stop", "js_errors": "report", "tolerance": 0.5, "show": "yes", "after": "close", "wait_s": 15 },
      "fields": [
        { "name": "name", "label": "Nome do teste", "kind": "text", "placeholder": "Login com senha certa" },
        { "name": "url", "label": "Endereço", "kind": "text", "placeholder": "https://…" },
        { "name": "steps", "label": "Roteiro", "kind": "rows", "add": "Passo", "recorder": true,
          "help": "Gravar abre o site: use ele normalmente e cada ação vira um passo. Na barra do topo, Ler campo devolve um texto da tela e Conferir garante que ele continua lá. Onde: um seletor CSS (#senha) ou texto=Entrar. Senhas: {{vault:nome}}.",
          "columns": [
            { "name": "do", "kind": "select", "options": [
              { "value": "click", "label": "Clicar", "tone": "act" }, { "value": "type", "label": "Digitar", "tone": "act" }, { "value": "select", "label": "Escolher opção", "tone": "act" },
              { "value": "key", "label": "Apertar tecla", "tone": "act" }, { "value": "hover", "label": "Passar o mouse", "tone": "act" }, { "value": "goto", "label": "Ir para endereço", "tone": "act" },
              { "value": "text", "label": "Conferir texto", "tone": "check" }, { "value": "see", "label": "Conferir que aparece", "tone": "check" }, { "value": "gone", "label": "Conferir que sumiu", "tone": "check" },
              { "value": "url", "label": "Conferir endereço", "tone": "check" }, { "value": "title", "label": "Conferir título", "tone": "check" }, { "value": "count", "label": "Conferir quantidade", "tone": "check" },
              { "value": "look", "label": "Comparar com a referência (visual)", "tone": "check" }, { "value": "a11y", "label": "Checar acessibilidade (básico)", "tone": "check" },
              { "value": "read", "label": "Ler campo (devolver)", "tone": "read" }, { "value": "shot", "label": "Capturar tela", "tone": "read" },
              { "value": "wait", "label": "Esperar aparecer", "tone": "wait" }, { "value": "sleep", "label": "Esperar (segundos)", "tone": "wait" } ] },
            { "name": "on", "placeholder": "Onde: #id ou texto=Entrar", "hide": { "do": ["key", "goto", "sleep", "shot", "url", "title", "look", "a11y"] } },
            { "name": "value", "placeholder": "Valor", "hide": { "do": ["click", "wait", "see", "gone", "hover", "a11y"] } }
          ] },
        { "name": "device", "label": "Tela", "kind": "select", "options": [{ "value": "desktop", "label": "Computador (1280 × 900)" }, { "value": "wide", "label": "Monitor grande (1920 × 1080)" }, { "value": "tablet", "label": "Tablet (820 × 1180)" }, { "value": "phone", "label": "Celular (390 × 844)" }] },
        { "name": "on_fail", "label": "Quando um passo falha", "kind": "select", "options": [{ "value": "stop", "label": "Parar o teste" }, { "value": "continue", "label": "Seguir e anotar todas as falhas" }] },
        { "name": "js_errors", "label": "Erro de JavaScript na página", "kind": "select", "options": [{ "value": "report", "label": "Só anotar no relatório" }, { "value": "fail", "label": "Reprova o teste" }] },
        { "name": "tolerance", "label": "Diferença visual aceita (%)", "kind": "number", "min": 0, "max": 100, "help": "Para o passo Comparar com a referência. A primeira execução grava a imagem de referência." },
        { "name": "show", "label": "Janela do navegador", "kind": "select", "options": [{ "value": "yes", "label": "Mostrar" }, { "value": "no", "label": "Não mostrar" }] },
        { "name": "after", "label": "No fim", "kind": "select", "show": { "show": ["yes"] }, "options": [{ "value": "close", "label": "Fechar se passou (aberto se falhou)" }, { "value": "close_always", "label": "Fechar sempre" }, { "value": "keep", "label": "Deixar aberto" }] },
        { "name": "wait_s", "label": "Esperar cada elemento por até (segundos)", "kind": "number", "min": 1, "max": 300 }
      ],
      "record": { "args": ["site.js", "--record"] },
      "run": { "program": "node", "args": ["site.js"], "timeout": 900000 }
    },
    {
      "type": "site", "name": "Automatizar site", "category": "Navegador",
      "desc": "Abre um site e segue os passos: clicar, digitar, ler.",
      "takes": "any", "gives": "object",
      "expects": "Qualquer dado, para usar no endereço e nos passos com {{input}}.",
      "returns": "Objeto com o endereço final, o título da página e o que os passos Ler campo guardaram.",
